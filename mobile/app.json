{
  "expo": {
    "name": "Maidaan",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/maidaan-icon.png",
    "scheme": "maidaan",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7847BA",
        "foregroundImage": "./assets/images/maidaan-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAFA",
          "imageWidth": 96,
          "image": "./assets/images/maidaan-icon.png"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Maidaan to find games and venues near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your Maidaan player profile.",
          "microphonePermission": false,
          "cameraPermission": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
