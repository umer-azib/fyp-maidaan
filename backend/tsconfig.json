{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Node16",
    "moduleResolution": "Node16",
    "ignoreDeprecations": "6.0",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/**/*.ts",
    "../shared/contracts.ts",
    "../shared/games.ts",
    "../shared/tokens.ts",
    "../shared/formats.ts",
    "test/**/*.ts",
    "scripts/**/*.ts"
  ]
}
