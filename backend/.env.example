PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
# Private PostgreSQL connection; verified provider TLS, server only.
DATABASE_URL=
# Private Storage only, never application Auth or client configuration.
SUPABASE_URL=
# Preferred server-only Supabase secret key. Legacy service-role key remains supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NODE_ENV=development

# Explicit development fixtures opt-in; never enable against production.
MAIDAAN_ENABLE_DEV_SEED=false

# Server-only Gemini intent extraction. Never use VITE_/EXPO_PUBLIC_ for this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Additive real venue / FYP manager import, development only.
MAIDAAN_ENABLE_DIRECTORY_IMPORT=false

# Vercel: NODE_ENV=production, exact HTTPS CORS_ORIGINS, Supabase transaction pooler
# DATABASE_URL with sslmode=verify-full. Never copy this development .env to Vercel.
# Keep both development opt-in flags false; VERCEL=1 also blocks fixtures/provisioning.
# See docs/VERCEL-BACKEND.md (repository root) for deployment settings and limits.
